APP_ENV=production
HOST=0.0.0.0
PORT=8000
MODEL_PATH=/app/models
MODEL_NAME=zipformer-vietnamese-30m-int8
SHERPA_NUM_THREADS=3
LOG_LEVEL=info
STT_API_KEY=replace-with-a-long-random-secret
STT_ALLOWED_ORIGINS=https://hood.io.vn
STT_MAX_SESSIONS=4
STT_MAX_SESSION_SECONDS=600
STT_VAD_THRESHOLD=0.5
STT_VAD_SILENCE=0.5
STT_IMAGE=vietnamese-stt:local
MODEL_HOST_PATH=./models
